# Entorno de ejecución: development | test | production
APP_ENV=development
HOST=127.0.0.1
PORT=3000

# MongoDB local. Sustituir por una URI de Atlas cuando corresponda.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=mycelium_iot_v2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# Puerto host opcional del contenedor Docker. Se usa 27018 para no colisionar
# con una instalación nativa que normalmente utiliza 27017.
MONGODB_DOCKER_PORT=27018

# El seed exige contraseñas de al menos 12 caracteres. Cámbielas antes de usarlo.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-new-admin-password
SEED_VIEWER_USERNAME=viewer
SEED_VIEWER_PASSWORD=replace-with-a-new-viewer-password
BCRYPT_ROUNDS=12

# Secreto de sesión JWT: mínimo 32 caracteres, aleatorio y exclusivo de este entorno.
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=mycelium_session
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_BLOCK_SECONDS=300

# Archivos JPEG locales. MongoDB conserva únicamente sus metadatos y referencias.
PHOTO_STORAGE_LOCAL_ROOT=./public/photos

# Se usará en la fase del simulador; queda centralizado desde ahora.
SIMULATION_INTERVAL_SECONDS=10
SIMULATION_AUTO_START=false
SIMULATION_API_CONTROL_ENABLED=true
