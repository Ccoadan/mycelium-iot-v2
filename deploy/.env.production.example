# Dirección inicial por IP: http://IP_PUBLICA
# Con un dominio apuntando a la VPS: hongos.ejemplo.com
SITE_ADDRESS=http://IP_PUBLICA

# Solo letras, números, guion y guion bajo en usuarios/nombre de base.
MONGODB_DB_NAME=mycelium_iot_v2
MONGO_INITDB_ROOT_USERNAME=mycelium_root
MONGO_INITDB_ROOT_PASSWORD=REEMPLAZAR_CON_48_CARACTERES_HEXADECIMALES
MONGO_APP_USERNAME=mycelium_app
MONGO_APP_PASSWORD=REEMPLAZAR_CON_48_CARACTERES_HEXADECIMALES
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_ADMIN_DE_16_O_MAS_CARACTERES
SEED_VIEWER_USERNAME=viewer
SEED_VIEWER_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_VIEWER_DE_16_O_MAS_CARACTERES
BCRYPT_ROUNDS=12

JWT_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=mycelium_session
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_BLOCK_SECONDS=300

SIMULATION_INTERVAL_SECONDS=10
SIMULATION_AUTO_START=true
SIMULATION_API_CONTROL_ENABLED=true
