{
  "name": "mycelium-iot-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Base local de la versión 2 del sistema IoT de monitoreo de micelio.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongodb",
    "seed": "tsx src/cli/seed.ts",
    "seed:prod": "node dist/cli/seed.js",
    "photos:import-samples": "tsx src/cli/import-photo-samples.ts",
    "photos:import-samples:prod": "node dist/cli/import-photo-samples.js",
    "simulation:status": "tsx scripts/simulation-control.ts status",
    "simulation:start": "tsx scripts/simulation-control.ts start",
    "simulation:stop": "tsx scripts/simulation-control.ts stop",
    "simulation:once": "tsx scripts/simulation-control.ts once",
    "simulation:interval": "tsx scripts/simulation-control.ts interval",
    "verify:setup": "tsx scripts/verify-setup.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:selenium": "node tests/system/selenium-dashboard.mjs",
    "test:jmeter": "node -e \"require('fs').mkdirSync('reports/jmeter',{recursive:true})\" && jmeter -n -t tests/load/mycelium-load-test.jmx -q tests/load/jmeter.properties -l reports/jmeter/results.jtl -e -o reports/jmeter/html -f",
    "check:frontend": "node --check public/js/dashboard.js",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run check:frontend && npm run build && npm test",
    "verify:ci": "npm run typecheck && npm run check:frontend && npm run build && npm run test:coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "hono": "^4.6.16",
    "mongodb": "^6.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^3.2.6",
    "mongodb-memory-server": "^10.1.3",
    "selenium-webdriver": "^4.46.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
